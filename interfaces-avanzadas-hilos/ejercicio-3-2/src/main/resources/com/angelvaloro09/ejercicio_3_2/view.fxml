<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="440.0" prefWidth="360.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.angelvaloro09.ejercicio_3_2.AppController">
   <padding>
      <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
   </padding>
   <children>
      <Label text="La Liebre y la Tortuga">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <Button fx:id="startRaceButton" mnemonicParsing="false" onAction="#onStartRaceClicked" prefWidth="130.0" text="¡Iniciar Carrera!">
         <font>
            <Font size="13.0" />
         </font>
      </Button>
      <Label fx:id="hareStatusLabel" text="La Liebre: Esperando...">
         <font>
            <Font size="14.0" />
         </font>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </Label>
      <ProgressBar fx:id="hareProgressBar" maxWidth="280.0" prefHeight="22.0" prefWidth="280.0" progress="0.0" />
      <Label fx:id="tortoiseStatusLabel" text="La Tortuga: Esperando...">
         <font>
            <Font size="14.0" />
         </font>
         <VBox.margin>
            <Insets top="15.0" />
         </VBox.margin>
      </Label>
      <ProgressBar fx:id="tortoiseProgressBar" maxWidth="280.0" prefHeight="22.0" prefWidth="280.0" progress="0.0" />
   </children>
</VBox>
